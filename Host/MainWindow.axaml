<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PiGadget.MainWindow"
        Title="Pi Gadget">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="Width" Value="75"/>
      <Setter Property="Height" Value="75"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
    </Style>
  </Window.Styles>

  <Grid Margin="20"
        ColumnDefinitions="80, 10, 80, 10, 80, 10, 80, 10, 80"
        RowDefinitions="90, 5, 90, 5, 90">
    <Button Grid.Column="0" Grid.Row="0" Click="NetworkScanner_Click" Background="#26B691"/>
    <TextBlock Grid.Column="0" Grid.Row="0" Text="Network Scanner"/>
    <Button Grid.Column="2" Grid.Row="0" Click="SystemStats_Click" Background="#2348A6"/>
    <TextBlock Grid.Column="2" Grid.Row="0" Text="System Stats"/>
    <Button Grid.Column="4" Grid.Row="0" Click="Calculator_Click" Background="#117312"/>
    <TextBlock Grid.Column="4" Grid.Row="0" Text="Calculator"/>
  </Grid>
</Window>

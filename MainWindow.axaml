<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PiGadget.MainWindow"
        Title="Pi Gadget" Width="480" Height="320"
        WindowState="Normal"
        SystemDecorations="None"
        CanResize="False"
        Background="#210a56">
  <Window.Styles>
    <Style Selector="Button">
      <Setter Property="CornerRadius" Value="15"/>
      <Setter Property="BorderBrush" Value="White"/>
      <Setter Property="BorderThickness" Value="2"/>
      <Setter Property="Width" Value="75"/>
      <Setter Property="Height" Value="75"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Top"/>
    </Style>
    <Style Selector="TextBlock">
      <Setter Property="FontFamily" Value="Arial"/>
      <Setter Property="FontSize" Value="10"/>
      <Setter Property="HorizontalAlignment" Value="Center"/>
      <Setter Property="VerticalAlignment" Value="Bottom"/>
      <Setter Property="Foreground" Value="White"/>
    </Style>
  </Window.Styles>

  <Grid Margin="20"
        ColumnDefinitions="80, 10, 80, 10, 80, 10, 80, 10, 80"
        RowDefinitions="90, 5, 90, 5, 90">
    <Button Grid.Column="0" Grid.Row="0" Click="NetworkTools_Click" Background="#26B691"/>
    <TextBlock Grid.Column="0" Grid.Row="0" Text="Network Tools"/>
    <Button Grid.Column="2" Grid.Row="0" Click="SystemTools_Click" Background="#2348A6"/>
    <TextBlock Grid.Column="2" Grid.Row="0" Text="System Tools"/>
    <Button Grid.Column="4" Grid.Row="0" Click="Calculator_Click" Background="#117312"/>
    <TextBlock Grid.Column="4" Grid.Row="0" Text="Calculator"/>
  </Grid>

</Window>
